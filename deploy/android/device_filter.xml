<?xml version="1.0" encoding="utf-8"?>
<!-- USB serial adapters UVScan can drive (UVScan.Serial.Android).
     Referenced from AndroidManifest.template.xml: when one of these is
     plugged in, Android offers to open UVScan and grants it permission. -->
<resources>
    <!-- FTDI: FT232R/BM, FT2232, FT4232, FT232H, FT-X (and the AVT-841's USB port if it is FTDI) -->
    <usb-device vendor-id="1027" />
    <!-- Silicon Labs CP210x -->
    <usb-device vendor-id="4292" product-id="60000" />
    <usb-device vendor-id="4292" product-id="60001" />
    <usb-device vendor-id="4292" product-id="60016" />
    <usb-device vendor-id="4292" product-id="60017" />
    <usb-device vendor-id="4292" product-id="60032" />
    <!-- WCH CH340 / CH341 -->
    <usb-device vendor-id="6790" product-id="29987" />
    <usb-device vendor-id="6790" product-id="21795" />
    <usb-device vendor-id="6790" product-id="29986" />
    <!-- Keyspan USA-19HS -->
    <usb-device vendor-id="1741" product-id="289" />
    <!-- Any CDC-ACM serial device (communications class) -->
    <usb-device class="2" />
</resources>
