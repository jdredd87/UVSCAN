object DisplayEditorForm: TDisplayEditorForm
  Left = 0
  Top = 0
  Caption = 'Display & alerts'
  ClientHeight = 700
  ClientWidth = 660
  Position = OwnerFormCenter
  FormFactor.Width = 320
  FormFactor.Height = 480
  FormFactor.Devices = [Desktop]
  DesignerMasterStyle = 0
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnResize = FormResize
  object lytButtons: TLayout
    Align = Bottom
    Size.Width = 660
    Size.Height = 50
    Size.PlatformDefault = False
    Padding.Left = 12
    Padding.Top = 10
    Padding.Right = 12
    Padding.Bottom = 12
    object btnClear: TButton
      Align = Left
      Size.Width = 90
      Size.Height = 26
      Size.PlatformDefault = False
      Text = 'Clear all'
      OnClick = btnClearClick
    end
    object btnCancel: TButton
      Align = Right
      Position.X = 560
      Position.Y = 10
      Size.Width = 85
      Size.Height = 26
      Size.PlatformDefault = False
      Text = 'Cancel'
      Cancel = True
      ModalResult = 2
    end
    object btnOK: TButton
      Align = Right
      Position.X = 470
      Position.Y = 10
      Size.Width = 85
      Size.Height = 26
      Size.PlatformDefault = False
      Margins.Right = 8
      Text = 'OK'
      Default = True
      ModalResult = 1
    end
  end
  object sbMain: TVertScrollBox
    Align = Client
    Size.Width = 660
    Size.Height = 650
    Size.PlatformDefault = False
    object lblPid: TLabel
      Align = Top
      Size.Width = 636
      Size.Height = 24
      Size.PlatformDefault = False
      Margins.Left = 12
      Margins.Top = 10
      Margins.Right = 12
      Text = 'PID'
      TextSettings.Trimming = Character
    end
    object lblHelp: TLabel
      Align = Top
      Size.Width = 636
      Size.Height = 40
      Size.PlatformDefault = False
      Margins.Left = 12
      Margins.Top = 2
      Margins.Right = 12
      TextSettings.WordWrap = True
      Text = 
        'How this PID looks in the live grid and on the dashboard. Al' +
        'ert levels change the colours, flash the row or gauge and so' +
        'und an alarm when the value crosses a threshold.'
    end
    object gbNormal: TGroupBox
      Align = Top
      Size.Width = 636
      Size.Height = 104
      Size.PlatformDefault = False
      Margins.Left = 12
      Margins.Top = 8
      Margins.Right = 12
      Padding.Left = 10
      Padding.Top = 26
      Padding.Right = 10
      Padding.Bottom = 6
      Text = 'Normal look'
      object rowFont: TLayout
        Align = Top
        Size.Width = 600
        Size.Height = 32
        Size.PlatformDefault = False
        object lblFontSize: TLabel
          Align = Left
          Size.Width = 100
          Size.Height = 32
          Size.PlatformDefault = False
          Text = 'Value font size'
        end
        object cbFontSize: TComboBox
          Align = Left
          Size.Width = 110
          Size.Height = 24
          Size.PlatformDefault = False
          Margins.Top = 4
          Margins.Bottom = 4
          OnChange = NormalChange
        end
      end
      object rowNormalColors: TLayout
        Align = Top
        Size.Width = 600
        Size.Height = 32
        Size.PlatformDefault = False
        object pairText: TLayout
          Align = Left
          Size.Width = 300
          Size.Height = 32
          Size.PlatformDefault = False
          object lblTextColor: TLabel
            Align = Left
            Size.Width = 100
            Size.Height = 32
            Size.PlatformDefault = False
            Text = 'Text colour'
          end
          object cbxText: TComboBox
            Align = Client
            Size.Width = 120
            Size.Height = 24
            Size.PlatformDefault = False
            Margins.Top = 4
            Margins.Bottom = 4
            OnChange = NormalChange
          end
        end
        object pairRow: TLayout
          Align = Client
          Size.Width = 280
          Size.Height = 32
          Size.PlatformDefault = False
          Margins.Left = 12
          object lblRowColor: TLabel
            Align = Left
            Size.Width = 90
            Size.Height = 32
            Size.PlatformDefault = False
            Text = 'Row colour'
          end
          object cbxRow: TComboBox
            Align = Client
            Size.Width = 120
            Size.Height = 24
            Size.PlatformDefault = False
            Margins.Top = 4
            Margins.Bottom = 4
            OnChange = NormalChange
          end
        end
      end
    end
    object gbLevels: TGroupBox
      Align = Top
      Size.Width = 636
      Size.Height = 360
      Size.PlatformDefault = False
      Margins.Left = 12
      Margins.Top = 8
      Margins.Right = 12
      Padding.Left = 10
      Padding.Top = 26
      Padding.Right = 10
      Padding.Bottom = 6
      Text = 
        'Alert levels - checked from the top, the first that matches ' +
        'is used'
      object lytLevelList: TLayout
        Align = Top
        Size.Width = 616
        Size.Height = 150
        Size.PlatformDefault = False
        Margins.Bottom = 6
        object lytLevelButtons: TLayout
          Align = Right
          Size.Width = 100
          Size.Height = 150
          Size.PlatformDefault = False
          Margins.Left = 8
          object btnAddLevel: TButton
            Align = Top
            Size.Width = 100
            Size.Height = 26
            Size.PlatformDefault = False
            Margins.Bottom = 4
            Text = 'Add'
            OnClick = btnAddLevelClick
          end
          object btnDeleteLevel: TButton
            Align = Top
            Size.Width = 100
            Size.Height = 26
            Size.PlatformDefault = False
            Margins.Bottom = 4
            Text = 'Remove'
            OnClick = btnDeleteLevelClick
          end
          object btnUp: TButton
            Align = Top
            Size.Width = 100
            Size.Height = 26
            Size.PlatformDefault = False
            Margins.Bottom = 4
            Text = 'Move up'
            OnClick = btnUpClick
          end
          object btnDown: TButton
            Align = Top
            Size.Width = 100
            Size.Height = 26
            Size.PlatformDefault = False
            Margins.Bottom = 4
            Text = 'Move down'
            OnClick = btnDownClick
          end
          object btnPresets: TButton
            Align = Top
            Size.Width = 100
            Size.Height = 26
            Size.PlatformDefault = False
            Margins.Top = 6
            Text = 'Presets...'
            OnClick = btnPresetsClick
          end
        end
        object lytLevelGrid: TLayout
          Align = Client
          Size.Width = 500
          Size.Height = 150
          Size.PlatformDefault = False
        end
      end
      object rowName: TLayout
        Align = Top
        Size.Width = 600
        Size.Height = 32
        Size.PlatformDefault = False
        object pairName: TLayout
          Align = Left
          Size.Width = 300
          Size.Height = 32
          Size.PlatformDefault = False
          object lblLevelName: TLabel
            Align = Left
            Size.Width = 100
            Size.Height = 32
            Size.PlatformDefault = False
            Text = 'Name'
          end
          object edtLevelName: TEdit
            Align = Client
            Size.Width = 120
            Size.Height = 24
            Size.PlatformDefault = False
            Margins.Top = 4
            Margins.Bottom = 4
            OnChangeTracking = LevelChange
          end
        end
        object pairWhen: TLayout
          Align = Client
          Size.Width = 280
          Size.Height = 32
          Size.PlatformDefault = False
          Margins.Left = 12
          object lblWhen: TLabel
            Align = Left
            Size.Width = 90
            Size.Height = 32
            Size.PlatformDefault = False
            Text = 'When value is'
          end
          object edtValue: TEdit
            Align = Right
            Size.Width = 70
            Size.Height = 24
            Size.PlatformDefault = False
            Margins.Left = 6
            Margins.Top = 4
            Margins.Bottom = 4
            OnChangeTracking = LevelChange
          end
          object cbOp: TComboBox
            Align = Client
            Size.Width = 120
            Size.Height = 24
            Size.PlatformDefault = False
            Margins.Top = 4
            Margins.Bottom = 4
            OnChange = LevelChange
          end
        end
      end
      object rowLevelColors: TLayout
        Align = Top
        Size.Width = 600
        Size.Height = 32
        Size.PlatformDefault = False
        object pairLevelRow: TLayout
          Align = Left
          Size.Width = 300
          Size.Height = 32
          Size.PlatformDefault = False
          object lblLevelRow: TLabel
            Align = Left
            Size.Width = 100
            Size.Height = 32
            Size.PlatformDefault = False
            Text = 'Row colour'
          end
          object cbxLevelRow: TComboBox
            Align = Client
            Size.Width = 120
            Size.Height = 24
            Size.PlatformDefault = False
            Margins.Top = 4
            Margins.Bottom = 4
            OnChange = LevelChange
          end
        end
        object pairLevelText: TLayout
          Align = Client
          Size.Width = 280
          Size.Height = 32
          Size.PlatformDefault = False
          Margins.Left = 12
          object lblLevelText: TLabel
            Align = Left
            Size.Width = 90
            Size.Height = 32
            Size.PlatformDefault = False
            Text = 'Text colour'
          end
          object cbxLevelText: TComboBox
            Align = Client
            Size.Width = 120
            Size.Height = 24
            Size.PlatformDefault = False
            Margins.Top = 4
            Margins.Bottom = 4
            OnChange = LevelChange
          end
        end
      end
      object rowFlash: TLayout
        Align = Top
        Size.Width = 600
        Size.Height = 28
        Size.PlatformDefault = False
        object chkFlash: TCheckBox
          Align = Client
          Size.Width = 500
          Size.Height = 28
          Size.PlatformDefault = False
          Margins.Left = 100
          Text = 'Flash the row and gauge while the value is in this level'
          OnChange = LevelChange
        end
      end
      object rowSound: TLayout
        Align = Top
        Size.Width = 600
        Size.Height = 32
        Size.PlatformDefault = False
        object lblSound: TLabel
          Align = Left
          Size.Width = 100
          Size.Height = 32
          Size.PlatformDefault = False
          Text = 'Sound'
        end
        object cbSound: TComboBox
          Align = Left
          Size.Width = 150
          Size.Height = 24
          Size.PlatformDefault = False
          Margins.Top = 4
          Margins.Right = 6
          Margins.Bottom = 4
          OnChange = LevelChange
        end
        object btnTestSound: TButton
          Align = Right
          Size.Width = 66
          Size.Height = 26
          Size.PlatformDefault = False
          Margins.Left = 6
          Margins.Top = 3
          Margins.Bottom = 3
          Text = 'Test'
          OnClick = btnTestSoundClick
        end
        object btnBrowseSound: TButton
          Align = Right
          Size.Width = 30
          Size.Height = 26
          Size.PlatformDefault = False
          Margins.Left = 4
          Margins.Top = 3
          Margins.Bottom = 3
          Text = '...'
          OnClick = btnBrowseSoundClick
        end
        object edtSoundFile: TEdit
          Align = Client
          Size.Width = 120
          Size.Height = 24
          Size.PlatformDefault = False
          Margins.Top = 4
          Margins.Bottom = 4
          OnChangeTracking = LevelChange
          TextPrompt = 'Sound file (.wav)'
        end
      end
      object rowRepeat: TLayout
        Align = Top
        Size.Width = 600
        Size.Height = 28
        Size.PlatformDefault = False
        object chkRepeat: TCheckBox
          Align = Client
          Size.Width = 500
          Size.Height = 28
          Size.PlatformDefault = False
          Margins.Left = 100
          Text = 
            'Repeat the sound every few seconds while the value stays in ' +
            'this level'
          OnChange = LevelChange
        end
      end
    end
    object gbPreview: TGroupBox
      Align = Top
      Size.Width = 636
      Size.Height = 86
      Size.PlatformDefault = False
      Margins.Left = 12
      Margins.Top = 8
      Margins.Right = 12
      Margins.Bottom = 12
      Padding.Left = 10
      Padding.Top = 28
      Padding.Right = 10
      Padding.Bottom = 8
      Text = 'Preview'
      object lblPreviewValue: TLabel
        Align = Left
        Size.Width = 44
        Size.Height = 32
        Size.PlatformDefault = False
        Text = 'Value'
      end
      object edtPreview: TEdit
        Align = Left
        Size.Width = 90
        Size.Height = 24
        Size.PlatformDefault = False
        Margins.Top = 10
        Margins.Bottom = 10
        OnChangeTracking = edtPreviewChange
        TextPrompt = 'try a value'
      end
      object pbPreview: TPaintBox
        Align = Client
        Size.Width = 400
        Size.Height = 44
        Size.PlatformDefault = False
        Margins.Left = 12
        OnPaint = pbPreviewPaint
      end
    end
  end
  object tmrFlash: TTimer
    Interval = 500
    OnTimer = tmrFlashTimer
    Left = 300
    Top = 656
  end
  object pmPresets: TPopupMenu
    Left = 360
    Top = 656
    object miHighIsBad: TMenuItem
      Text = 
        'Green / yellow / red - high values are bad (knock retard, te' +
        'mperatures)'
      OnClick = miHighIsBadClick
    end
    object miLowIsBad: TMenuItem
      Text = 
        'Green / yellow / red - low values are bad (voltage, oil pres' +
        'sure)'
      OnClick = miLowIsBadClick
    end
  end
end
